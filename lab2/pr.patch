diff --git a/api/app/routes/shipments.py b/api/app/routes/shipments.py
new file mode 100644
index 0000000..4e857b1
--- /dev/null
+++ b/api/app/routes/shipments.py
@@ -0,0 +1,23 @@
+from fastapi import APIRouter, Depends
+
+from app.auth import require_api_key
+from app.db import get_conn
+from app.pagination import paginate
+
+router = APIRouter(prefix="/v2")
+
+
+@router.get("/shipments/search", dependencies=[Depends(require_api_key)])
+def search_shipments(city: str, page: int = 1, size: int = 10):
+    query = f"SELECT id, ref, status, city FROM shipments WHERE city = '{city}'"
+    rows = get_conn().execute(query).fetchall()
+    items = [dict(zip(("id", "ref", "status", "city"), r)) for r in rows]
+    return paginate(items, page - 1, size)
+
+
+@router.delete("/shipments/{shipment_id}")
+def delete_shipment(shipment_id: int):
+    conn = get_conn()
+    conn.execute("DELETE FROM shipments WHERE id = ?", (shipment_id,))
+    conn.commit()
+    return {"deleted": shipment_id}
