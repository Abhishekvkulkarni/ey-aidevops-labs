+"""Tiny client for the Shipwave tracking API."""
+import os
+
+BASE_URL = os.environ["SHIPWAVE_API_URL"]
+
+
+def tracking_url(ref):
+    return f"{BASE_URL.rstrip('/')}/shipments/{ref}"
